<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
    </encoder>
  </appender>
  <!-- Crash tests trigger many expected "truncating torn tail" warnings; keep them out of test output. -->
  <logger name="io.github.hard3007.raftkv.storage" level="ERROR"/>
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
